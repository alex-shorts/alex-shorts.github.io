  "build_chains": [
    {
      "id": "chain-paths",
      "label": "Two paths (foundation)",
      "steps": [
        "Way of Life ↔ Way of Death",
        "Wise / righteous ↔ Fool / wicked",
        "Every rung lived on one road or the other"
      ],
      "note": "Overarching frame. Domains below do not replace the fork — they express which road a man is on."
    },
    {
      "id": "chain-speech",
      "label": "Speech",
      "steps": [
        "Listen (child)",
        "Guard mouth (youth)",
        "Wise words",
        "Counsel / soft answer",
        "Lips that feed many",
        "Shepherding word"
      ],
      "note": "Load-bearing domain. Almost every higher fruit of the tongue presupposes lower mastery."
    },
    {
      "id": "chain-diligence",
      "label": "Diligence → Wealth → Skill",
      "steps": [
        "Diligence (youth)",
        "Wealth / provide (household)",
        "Skill before kings (ruler)",
        "Faithful over much (peak)"
      ],
      "note": "Wealth is not a root — it is built on diligence. Skill before kings is diligence recognized."
    },
    {
      "id": "chain-justice",
      "label": "Justice & blessing many",
      "steps": [
        "Integrity formed below",
        "Justice at the gate",
        "Justice for the poor / throne",
        "Strength that blesses many",
        "Reign with Christ"
      ],
      "note": "Justice and wide blessing sit high — they require a man already mastered in tongue, hand, and passions."
    },
    {
      "id": "chain-passions",
      "label": "Passions (death flank, lower)",
      "steps": [
        "Refuse rod",
        "Flesh desires / forbidden woman / wine",
        "Laziness · anger · pride · reckless tongue",
        "Same vices scaled: house → city → throne"
      ],
      "note": "Youthful passions parked low. Unmastered, they reappear amplified at every higher rung."
    }
  ],
